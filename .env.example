# BRAINTRUST_API_KEY is read from the shell if exported; set it here otherwise.
# BRAINTRUST_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional model overrides for the eval harness (default gpt-4o-mini via the
# Braintrust proxy -- no separate provider key needed).
# CALLER_MODEL=
# JUDGE_MODEL=

# Optional audio-only empathy scorer override. Defaults to the Braintrust gateway
# and an OpenAI audio-capable chat model so the scorer can listen to the final WAV.
# AUDIO_EMPATHY_MODEL=gpt-audio-1.5
# AUDIO_EMPATHY_BASE_URL=https://gateway.braintrust.dev
# AUDIO_EMPATHY_API_KEY=
